# Copiar este archivo como .env y completar los valores.
# Nunca commitear el archivo .env con credenciales reales.

# --- Base de datos PostgreSQL (contenedor "db") ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=walking_dictionary

# --- Backend (Node.js / Express) ---
JWT_SECRET=change-me

# --- Frontend (React / Vite) ---
# URL con la que el navegador (fuera de Docker) llega al backend.
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_USE_MOCK=false
VITE_DOCENTE_ID_SIMULADO=1
VITE_INSCRIPCION_ID_SIMULADA=1

VITE_ESTUDIANTE_ID_SIMULADO=2
GOOGLE_CLIENT_ID=508368789495-ho3nb17ce63id81rdht97tuqpvouisb0.apps.googleusercontent.com

